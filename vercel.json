{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "api", "format": "url", "env": "API_URL" }]
    },
    "api": {
      "root": "apps/api",
      "framework": "fastapi",
      "entrypoint": "resolvedesk.main:app",
      "devCommand": "uv run uvicorn resolvedesk.main:app --host 127.0.0.1 --port $PORT",
      "bindings": [{ "type": "service", "service": "web", "format": "url", "env": "AUTH_URL" }],
      "functions": { "resolvedesk/main.py": { "maxDuration": 60 } }
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }],
  "crons": [{ "path": "/api/maintenance", "schedule": "0 3 * * *" }]
}
